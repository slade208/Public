## Windows from nothing to a joined Claude Code session

## The one-liner (PowerShell)
irm operations.dev/claude-win-join.ps1 | iex
# Installs what's missing, pauses for the logins, clones + links the tree,
# writes the hooks. Re-runnable; it skips whatever is already done.

## ---------- or do it by hand ----------

## 1. Node, git, GitHub CLI
winget install OpenJS.NodeJS.LTS Git.Git GitHub.cli
# close and reopen the terminal so PATH picks them up

## 2. Claude Code
npm install -g @anthropic-ai/claude-code

## 3. Log in - both need a browser or device code
gh auth login
gh auth setup-git
claude
# (log in, then exit claude)

## 4. Make the project folder and let Claude Code register it
mkdir C:\projects\myproject; cd C:\projects\myproject
claude
# start it, then exit - this creates the state dir the join step links into

## 5. Clone the knowledge tree and join
git clone https://github.com/slade208/agent-notes $HOME\agent-notes
pwsh $HOME\agent-notes\tooling\join.ps1 -ProjectPath C:\projects\myproject
# uses a directory JUNCTION - no admin rights, no developer mode needed

## 6. Hooks - in <project>\.claude\settings.json
{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "shell": "bash",
      "command": "bash $HOME/agent-notes/tooling/hooks/session-start.sh" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "shell": "bash",
      "command": "bash $HOME/agent-notes/tooling/hooks/stop.sh" }] }]
  }
}
# the hooks are bash - Git for Windows provides it, installed in step 1
# and: $env:AGENT_NOTES_SEAT = "my-seat-name"

## 7. Prove it
Get-Item $env:USERPROFILE\.claude\projects\*\memory | Select-Object LinkType
# must say Junction
# then start claude and ask: "what do you remember?"
# joined = a grouped list of facts; empty = the link didn't take

## Throwaway box - clean up when done
Remove-Item $HOME\agent-notes -Recurse -Force
# the junction is removed with the project's .claude dir; nothing is lost

